# Optional process environment. server.py does not load this file automatically.
# For normal use, configure the provider in the application's settings page.
# Leave provider fields empty for offline mode. Never commit a real API key.
MOYU_HOST=127.0.0.1
MOYU_PORT=4173
# Empty MOYU_DB is not a valid default: omit it to use ./moyu.sqlite3.
# MOYU_DB=/absolute/path/to/moyu.sqlite3
# MOYU_CREDENTIALS_DIR=/absolute/path/to/private-credentials
MOYU_AI_BASE_URL=
MOYU_AI_MODEL=
MOYU_AI_API_KEY=
MOYU_AI_TEMPERATURE=0.65
# 0 means no daily request-count limit; it is not a currency spending limit.
MOYU_AI_DAILY_QUOTA=0
