{
  "benchmark": "budgeted-continuation-first-pass",
  "version": "1.0",
  "baseline_date": "2026-10-23",
  "environment": {
    "python": "3.11.17",
    "platform": "macOS-26.6.1-arm64-arm-64bit",
    "engine_module": "backend/moyu_continuation.py",
    "engine_sha256": "61d170e5cd7bc951516abce6c0b568f3405f965df37bd2eec34a3467baafec33"
  },
  "config": {
    "seed": 20261023,
    "repeat": 2,
    "scenarios": 20,
    "targets": [
      2500,
      3000,
      4000
    ],
    "max_rounds": 6,
    "min_round_gain": 50,
    "tolerance": 0.1,
    "counting_rule": "non_whitespace_characters_including_punctuation",
    "q1_target_characters": 3000,
    "q1_target_rate": 0.8,
    "engine_variant": "v1.2",
    "max_stall_retries": 1,
    "hard_max_rounds": 12,
    "closing_hint": true,
    "overshoot_guard": true,
    "stall_strategy": true
  },
  "engine": {
    "variant": "v1.2",
    "label": "v1.2（引擎默认）",
    "engine_version": "1.2",
    "max_stall_retries": 1,
    "hard_max_rounds": 12,
    "closing_hint": true,
    "overshoot_guard": true,
    "stall_strategy": true,
    "hard_max_rounds_note": "固定硬上限"
  },
  "assumptions": {
    "mix_is_assumption": true,
    "mix_note": "20 个场景的档位配比是假设，不是从真实模型测得的分布；总体一次通过率随配比变化，分层包络更可信。",
    "qualified_tiers": [
      "calibrated",
      "steady",
      "cautious"
    ],
    "deficient_tiers": [
      "volatile",
      "underpowered",
      "stalling"
    ],
    "interrupted_tiers": [
      "budget_limited",
      "canceled"
    ],
    "tiers": {
      "calibrated": {
        "label": "一次到位",
        "yield_note": "单轮产出 ≈ 剩余额度的 100%±5%",
        "behaviour": "首轮即达标",
        "ratio": [
          1.0,
          0.05
        ],
        "fixed_yield": null
      },
      "steady": {
        "label": "渐进收敛",
        "yield_note": "单轮产出 ≈ 剩余额度的 50%±8%",
        "behaviour": "3–5 轮收敛",
        "ratio": [
          0.5,
          0.08
        ],
        "fixed_yield": null
      },
      "cautious": {
        "label": "保守欠量",
        "yield_note": "单轮产出 ≈ 剩余额度的 38%±4%",
        "behaviour": "5–6 轮勉强收敛，贴近 max_rounds 上限",
        "ratio": [
          0.38,
          0.04
        ],
        "fixed_yield": null
      },
      "volatile": {
        "label": "无视预算",
        "yield_note": "单轮产出 ≈ 剩余额度的 75%±50%（可超过 100%）",
        "behaviour": "常首轮超冲，越过 +10% 上限",
        "ratio": [
          0.75,
          0.5
        ],
        "fixed_yield": null
      },
      "underpowered": {
        "label": "产出不足",
        "yield_note": "单轮产出 ≈ 剩余额度的 18%±3%",
        "behaviour": "6 轮仍达不到下限",
        "ratio": [
          0.18,
          0.03
        ],
        "fixed_yield": null
      },
      "stalling": {
        "label": "停滞",
        "yield_note": "单轮固定 12–30 字，低于 min_round_gain=50",
        "behaviour": "首轮即判 NO_PROGRESS",
        "ratio": null,
        "fixed_yield": [
          12,
          30
        ]
      },
      "budget_limited": {
        "label": "预算受限",
        "yield_note": "产出同 steady，但预算在第 3 轮开始前耗尽",
        "behaviour": "BUDGET_EXHAUSTED",
        "ratio": [
          0.5,
          0.08
        ],
        "fixed_yield": null
      },
      "canceled": {
        "label": "作者取消",
        "yield_note": "产出同 steady，但第 2 轮开始前作者取消",
        "behaviour": "CANCELED",
        "ratio": [
          0.5,
          0.08
        ],
        "fixed_yield": null
      }
    }
  },
